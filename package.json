{
  "name": "field-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Field Design System: Precision-crafted, dark-first design system with React client libraries, interactive sticker sheet, and theme editor.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@field/showcase",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "design-tokens",
    "dark-mode",
    "theme-editor",
    "accessible"
  ],
  "author": "Field Design Team",
  "license": "MIT"
}
