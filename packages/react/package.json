{
  "name": "@sam.barfield/field-react",
  "version": "0.2.2",
  "description": "Smart, precision-crafted React component library for the Field Design System",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/field.css",
    "./styles/field.css": "./dist/styles/field.css",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); fs.mkdirSync('dist/styles', { recursive: true }); fs.copyFileSync('src/styles/field.css', 'dist/styles/field.css');\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sam.barfield/field-tokens": "^0.2.2",
    "lucide-react": "^0.475.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "@sam.barfield:registry": "https://gitlab.xencloud.io/api/v4/projects/17/packages/npm/"
  }
}
