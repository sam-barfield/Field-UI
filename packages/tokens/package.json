{
  "name": "@sam.barfield/field-tokens",
  "version": "0.2.4",
  "description": "Minimal, inheritable, multi-platform design tokens for Field Design System",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); fs.copyFileSync('src/tailwind.css', 'dist/tailwind.css');\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "@sam.barfield:registry": "https://gitlab.xencloud.io/api/v4/projects/17/packages/npm/"
  }
}
