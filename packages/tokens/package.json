{
  "name": "@sam.barfield/field-tokens",
  "version": "0.5.0",
  "description": "Minimal, inheritable, multi-platform design tokens for Field Design System",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./themes/*": "./dist/themes/*",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "@sam.barfield:registry": "https://gitlab.xencloud.io/api/v4/projects/17/packages/npm/"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT"
}
